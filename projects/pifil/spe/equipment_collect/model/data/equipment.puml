@startuml
hide empty members

class EquipmentConfiguration {
    + id: Identifier
    + startDate: Date
    + fileName: String
    + configurationVersion: String [0..1]
}

class EquipmentOnBoardPlatform {
    + id: Identifier
    + startDateTime: DateTime
    + endDateTime: DateTime [0..1]
    + comments: String [0..1]
}

class Gear {
}

class Platform {
}

class Equipment {
    + id: Identifier
    + serialNumber: String [0..1]
    + deliveryDate: Date
    + daysBetweenTwoCalibrations: Integer
    + lastCalibrationDate: Date [0..1]
    + docRef: String [0..1]
    + comments: String [0..1]
}

class EquipmentModel {
}

class EquipmentMeasurement {
}

class EquipmentDeliveryState {
}

EquipmentConfiguration "*" --> "1" EquipmentOnBoardPlatform: equipmentOnBoardPlatform
EquipmentOnBoardPlatform "*" -left-> "1" Platform: platform
EquipmentOnBoardPlatform "*" -right-> "0..1" Gear: gear
EquipmentOnBoardPlatform "*" --> "1" Equipment: equipment
Equipment "*" -left-> "1" EquipmentModel: model
Equipment "1" *-- "*" EquipmentMeasurement: equipmentMeasurement
Equipment "*" -right-> "1" EquipmentDeliveryState: equipmentDeliveryState

@enduml